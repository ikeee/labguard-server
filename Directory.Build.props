<Project>
  <!-- 版本号统一在这里改：所有项目共用；与客户端仓库 ikeee/labguard lockstep -->
  <PropertyGroup>
    <Version>0.11.1</Version>
    <AssemblyVersion>0.11.1.0</AssemblyVersion>
    <FileVersion>0.11.1.0</FileVersion>
    <Company>LabGuard Server (open source)</Company>
    <Product>LabGuard Server</Product>
    <Copyright>MIT License</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>CS0618;CS1591</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>
